{
  "name": "Snatzee — Yahtzee scores & stats",
  "short_name": "Snatzee",
  "description": "Houd je Yahtzee-scores, records, statistieken en achievements bij met vrienden.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#07131F",
  "theme_color": "#07131F",
  "lang": "nl",
  "dir": "ltr",
  "categories": [
    "games",
    "sports",
    "social"
  ],
  "icons": [
    {
      "src": "/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
