# ===========================================================================
# Snatzee environment
#
# Self-hosted (docker compose):
#   1. node scripts/generate-keys.mjs   -> paste the four secrets below
#   2. set PUBLIC_URL to the address people will actually open
#   3. docker compose up -d --build
#
# Hosted Supabase (Vercel or `npm run dev`): fill in only the
# "Application" block, using the values from your Supabase dashboard.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# The CANONICAL origin: one value, no second uncommented PUBLIC_URL line.
# A .env file keeps the last assignment of a key, so two active lines silently
# leave one of them in charge.
#
# This one address is used for OAuth callbacks, e-mail links, stored avatar
# URLs and page metadata. It is NOT the only domain the app answers on — see
# "Serving several domains" below.
#   local docker:  http://localhost:6666
#   production:    https://www.snatzee.nl
PUBLIC_URL=http://localhost:6666

# --- Serving several domains -----------------------------------------------
# The app follows the address bar: the browser talks to the Supabase APIs on
# whatever domain it is already on, because the gateway serves them from the
# same origin. So extra domains need no rebuild and no extra variables here —
# just point them at this host and list them in the two settings below.
#
# Pick the domain you want links and e-mails to use as PUBLIC_URL, then:
#   ADDITIONAL_REDIRECT_URLS  every domain people may sign in from
#   MAILER_EXTERNAL_HOSTS     every hostname allowed in confirmation links

# Hosted Supabase only — leave unset when using docker compose, which derives
# these from PUBLIC_URL and ANON_KEY.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SITE_URL=https://www.snatzee.nl

# Published port of the gateway.
HTTP_PORT=6666

# ---------------------------------------------------------------------------
# Secrets — generate with: node scripts/generate-keys.mjs
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Lifetime of an access token, in seconds. Sessions refresh automatically.
JWT_EXPIRY=3600

# Extra origins a user may be redirected back to after signing in. Comma
# separated, wildcards allowed. Include every domain the app is served on,
# and the iOS app's URL scheme once it exists (e.g. snatzee://**).
ADDITIONAL_REDIRECT_URLS=https://snatzee.frankvandetechniek.nl/**,https://www.snatzee.nl/**,http://localhost:6666/**

# Hostnames (no scheme, comma separated) allowed to appear in confirmation and
# password-reset links. List every domain the app is served on.
MAILER_EXTERNAL_HOSTS=snatzee.frankvandetechniek.nl,www.snatzee.nl

# Set to true to close registration once your group has signed up.
DISABLE_SIGNUP=false

# With no SMTP server configured there is no way to deliver a confirmation
# mail, so new accounts are active immediately. Set to false after filling in
# the SMTP block below; de bevestigingslink komt dan uit op /auth/confirm,
# dat elke vorm afhandelt die GoTrue kan sturen.
MAILER_AUTOCONFIRM=true

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# --- Toegestane domeinen ---------------------------------------------------
# Kommagescheiden hosts waarop de app draait (met poort als die niet 80/443
# is). Redirects na inloggen gaan alleen naar een van deze; een vervalste
# X-Forwarded-Host valt terug op PUBLIC_URL. Leeg = elk domein (oud gedrag).
#   ALLOWED_HOSTS=snatzee.frankvandetechniek.nl,www.snatzee.nl
ALLOWED_HOSTS=

# --- Sign in with Apple ----------------------------------------------------
# Naast e-mail de enige manier om in te loggen.
# Return URL in your Apple Service ID:
#   ${PUBLIC_URL}/auth/v1/callback
# Op false verdwijnt de knop ook uit de app.
# APPLE_CLIENT_ID: kommagescheiden — eerst de Services ID (website), dan de
# bundle ID van de iOS-app, bijv. nl.snatzee.web,nl.snatzee.app
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_SECRET=

# ---------------------------------------------------------------------------
# Push notifications (optional)
# ---------------------------------------------------------------------------
# Generate once with: node scripts/generate-vapid-keys.mjs
#
# The pair identifies this server to Apple's, Google's and Mozilla's push
# services. Regenerating invalidates every existing subscription, so keep
# these values once they are in use.
#
# Leave them empty to ship without push: the toggle in Settings then reports
# that the device does not support meldingen, and nothing else changes.
#
# iOS only delivers push to an app that was added to the homescreen, and only
# after the person taps "Zet aan" — Safari will not raise the permission sheet
# without a tap, and Apple offers no way to install the app automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can reach you on. Must be a mailto: or
# https: URL.
VAPID_SUBJECT=mailto:admin@snatzee.nl

# Hoe vaak de server de meldingenwachtrij verstuurt, in seconden. 0 = alleen
# direct na een actie in de web-app (oud gedrag).
PUSH_DRAIN_INTERVAL_SECONDS=15

# ---------------------------------------------------------------------------
# iOS-app (optioneel — alles leeg laten tot de app bestaat)
# ---------------------------------------------------------------------------
# Push via APNs: een .p8-sleutel uit Certificates, Identifiers & Profiles →
# Keys, met "Apple Push Notifications service" aangevinkt. De inhoud van het
# bestand mag op één regel met \n voor de regeleinden.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# Sign in with Apple-tokens intrekken bij het verwijderen van een account
# (verplicht voor de App Store). Een .p8-sleutel met "Sign in with Apple"
# aangevinkt; mag dezelfde zijn als hierboven als beide aan staan.
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=

# Universal links: welke app de links op dit domein mag openen.
#   APPLE_APP_IDS=ABCDE12345.nl.snatzee.app
APPLE_APP_IDS=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
