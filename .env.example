# ===========================================================================
# Snatzee environment
#
# Self-hosted (docker compose):
#   1. node scripts/generate-keys.mjs   -> paste the four secrets below
#   2. set PUBLIC_URL to the address people will actually open
#   3. docker compose up -d --build
#
# Hosted Supabase (Vercel or `npm run dev`): fill in only the
# "Application" block, using the values from your Supabase dashboard.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# The origin people open in a browser. On a self-hosted stack the app and the
# Supabase APIs share this origin, so both variables get the same value.
#   local docker:  http://localhost:6666
#   production:    https://www.snatzee.nl
PUBLIC_URL=http://localhost:6666

# Hosted Supabase only — leave unset when using docker compose, which derives
# these from PUBLIC_URL and ANON_KEY.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SITE_URL=https://www.snatzee.nl

# Published port of the gateway.
HTTP_PORT=6666

# ---------------------------------------------------------------------------
# Secrets — generate with: node scripts/generate-keys.mjs
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Lifetime of an access token, in seconds. Sessions refresh automatically.
JWT_EXPIRY=3600

# Extra origins a user may be redirected back to after signing in. Comma
# separated, wildcards allowed. Include every domain the app is served on.
ADDITIONAL_REDIRECT_URLS=https://snatzee.frankvandetechniek.nl/**,https://www.snatzee.nl/**,http://localhost:6666/**

# Set to true to close registration once your group has signed up.
DISABLE_SIGNUP=false

# With no SMTP server configured there is no way to deliver a confirmation
# mail, so new accounts are active immediately. Set to false after filling in
# the SMTP block below.
MAILER_AUTOCONFIRM=true

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# --- Sign in with Google ---------------------------------------------------
# Authorised redirect URI in Google Cloud Console:
#   ${PUBLIC_URL}/auth/v1/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Sign in with Apple ----------------------------------------------------
# Return URL in your Apple Service ID:
#   ${PUBLIC_URL}/auth/v1/callback
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_SECRET=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
