# ---------------------------------------------------------------------------
# Snatzee environment
# Copy to .env.local (development) or .env (Docker) and fill in your values.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose, RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this deployment. Used for metadata and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only — never expose these to the browser.
# Required exclusively by `npm run seed` (demo data for development).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
